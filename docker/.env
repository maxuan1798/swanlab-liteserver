# SwanLab All-in-One 环境变量配置
# 复制此文件为 .env_test 并根据需要修改配置

# ===========================================
# 端口配置
# ===========================================
SWANLAB_PORT=5173
MYSQL_PORT=3306
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379
NGINX_PORT=80
FLUENT_BIT_PORT=24224

# ===========================================
# MySQL数据库配置
# ===========================================
MYSQL_ROOT_PASSWORD=swanlab_root_123
MYSQL_DATABASE=swanlab_cloud
MYSQL_USER=swanlab_user
MYSQL_PASSWORD=swanlab_user_456

# ===========================================
# ClickHouse配置
# ===========================================
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=password123

# ===========================================
# MinIO对象存储配置
# ===========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=swanlab

# ===========================================
# Redis配置
# ===========================================
REDIS_PASSWORD=

# ===========================================
# SwanLab应用配置
# ===========================================
SWANLAB_CLOUD_SYNC=1

# ===========================================
# 安全配置建议 (生产环境请修改以下密码)
# ===========================================
# MYSQL_ROOT_PASSWORD=your_secure_mysql_root_password
# MYSQL_PASSWORD=your_secure_mysql_user_password
# CLICKHOUSE_PASSWORD=your_secure_clickhouse_password
# MINIO_ROOT_PASSWORD=your_secure_minio_password
# REDIS_PASSWORD=your_secure_redis_password
