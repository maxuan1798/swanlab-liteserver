# SwanLab All-in-One Docker Image
# 包含所有服务：SwanLab服务器、MySQL、ClickHouse、Redis、MinIO、Nginx、Fluent Bit

FROM ubuntu:22.04

# 设置非交互模式
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# 设置时区
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 更新系统并安装基础软件包
RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    wget \
    curl \
    gnupg \
    lsb-release \
    software-properties-common \
    apt-transport-https \
    ca-certificates \
    supervisor \
    gcc \
    g++ \
    make \
    cmake \
    python3 \
    python3-dev \
    python3-pip \
    netcat-openbsd \
    telnet \
    vim \
    htop \
    procps \
    dirmngr \
    && rm -rf /var/lib/apt/lists/*

# 创建python符号链接
RUN ln -sf /usr/bin/python3 /usr/bin/python

# 安装Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# 安装MySQL Server
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y mysql-server && \
    rm -rf /var/lib/apt/lists/*

# 安装Redis
RUN apt-get update && apt-get install -y redis-server && \
    rm -rf /var/lib/apt/lists/*

# 安装Nginx
RUN apt-get update && apt-get install -y nginx && \
    rm -rf /var/lib/apt/lists/*

# 安装ClickHouse (使用官方仓库)
RUN apt-get update && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL 'https://packages.clickhouse.com/rpm/lts/repodata/repomd.xml.key' | gpg --dearmor -o /etc/apt/keyrings/clickhouse-keyring.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/clickhouse-keyring.gpg] https://packages.clickhouse.com/deb stable main" | tee /etc/apt/sources.list.d/clickhouse.list && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y clickhouse-server clickhouse-client && \
    rm -rf /var/lib/apt/lists/*

# 安装MinIO
RUN wget https://dl.min.io/server/minio/release/linux-amd64/minio -O /usr/local/bin/minio && \
    chmod +x /usr/local/bin/minio && \
    wget https://dl.min.io/client/mc/release/linux-amd64/mc -O /usr/local/bin/mc && \
    chmod +x /usr/local/bin/mc

# 创建必要的目录和设置基本权限
RUN mkdir -p \
    /var/lib/mysql-files \
    /var/log/mysql \
    /var/log/clickhouse-server \
    /var/log/redis \
    /var/log/nginx \
    /var/log/minio \
    /var/log/fluent-bit \
    /var/log/supervisor \
    /etc/supervisor/conf.d \
    /data/minio \
    /data/clickhouse \
    /data/mysql \
    /data/redis \
    /docker-entrypoint-initdb.d \
    /var/run/nginx \
    /var/run/clickhouse-server \
    /var/run/supervisor && \
    chown mysql:mysql /var/lib/mysql-files /var/log/mysql 2>/dev/null || true && \
    chown redis:redis /var/log/redis 2>/dev/null || true && \
    chown www-data:www-data /var/log/nginx /var/run/nginx 2>/dev/null || true

# 设置工作目录
WORKDIR /app

# 复制项目文件（.dockerignore 已配置允许复制 docker 配置文件）
COPY . .

# 安装Python依赖
RUN pip3 install --no-cache-dir -r requirements.txt

# 安装Node.js依赖并构建前端
RUN npm install && npm run build

# 创建应用目录
RUN mkdir -p /app/data /app/logs

# 复制配置文件从 docker/ 文件夹到系统目录
# Supervisor 配置和启动脚本 (使用简化版本)
RUN cp /app/docker/supervisor-simple.conf /etc/supervisor/conf.d/supervisord.conf && \
    cp /app/docker/start-services-simple.sh /start-services.sh && \
    chmod +x /start-services.sh

# MySQL 配置和初始化脚本
RUN if [ -f /app/docker/mysql/conf.d/mysql.cnf ]; then \
        cp /app/docker/mysql/conf.d/mysql.cnf /etc/mysql/mysql.conf.d/mysql.cnf; \
    fi && \
    if [ -d /app/docker/mysql/init ]; then \
        cp -r /app/docker/mysql/init/* /docker-entrypoint-initdb.d/ 2>/dev/null || true; \
    fi

# ClickHouse 配置和初始化脚本
RUN if [ -f /app/docker/clickhouse/config.xml ]; then \
        cp /app/docker/clickhouse/config.xml /etc/clickhouse-server/config.xml; \
    fi && \
    if [ -f /app/docker/clickhouse/init/init.sql ]; then \
        mkdir -p /etc/clickhouse-server/init && \
        cp /app/docker/clickhouse/init/init.sql /etc/clickhouse-server/init/init.sql; \
    fi

# Nginx 配置 (使用all-in-one专用配置)
RUN if [ -f /app/docker/nginx/nginx-all-in-one.conf ]; then \
        cp /app/docker/nginx/nginx-all-in-one.conf /etc/nginx/nginx.conf; \
    elif [ -f /app/docker/nginx/nginx.conf ]; then \
        cp /app/docker/nginx/nginx.conf /etc/nginx/nginx.conf; \
    fi

# Fluent Bit 配置 (如果需要日志收集)
RUN if [ -f /app/docker/fluent-bit/fluent-bit.conf ]; then \
        mkdir -p /etc/fluent-bit && \
        cp /app/docker/fluent-bit/fluent-bit.conf /etc/fluent-bit/fluent-bit.conf; \
    fi && \
    if [ -f /app/docker/fluent-bit/parsers.conf ]; then \
        cp /app/docker/fluent-bit/parsers.conf /etc/fluent-bit/parsers.conf; \
    fi

# 设置文件权限
RUN chown -R mysql:mysql /var/lib/mysql /var/log/mysql 2>/dev/null || true && \
    chown -R clickhouse:clickhouse /var/lib/clickhouse /var/log/clickhouse-server 2>/dev/null || true && \
    chown -R redis:redis /var/lib/redis /var/log/redis 2>/dev/null || true

# 设置环境变量
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV SWANLAB_LOG_DIR=/app/logs
ENV SWANLAB_DATA_DIR=/app/data

# MySQL环境变量
ENV MYSQL_ROOT_PASSWORD=swanlab123
ENV MYSQL_DATABASE=swanlab_cloud
ENV MYSQL_USER=swanlab_user
ENV MYSQL_PASSWORD=swanlab456

# ClickHouse环境变量
ENV CLICKHOUSE_USER=default
ENV CLICKHOUSE_PASSWORD=password123

# MinIO环境变量
ENV MINIO_ROOT_USER=minioadmin
ENV MINIO_ROOT_PASSWORD=minioadmin

# Redis环境变量
ENV REDIS_PASSWORD=""

# SwanLab环境变量
ENV SWANLAB_CLOUD_SYNC=1
ENV MYSQL_HOST=localhost
ENV MYSQL_PORT=3306
ENV CLICKHOUSE_HOST=localhost
ENV CLICKHOUSE_PORT=9000
ENV REDIS_HOST=localhost
ENV REDIS_PORT=6379
ENV MINIO_ENDPOINT=http://localhost:9000
ENV MINIO_ACCESS_KEY=minioadmin
ENV MINIO_SECRET_KEY=minioadmin
ENV MINIO_BUCKET=swanlab

# 暴露端口
# SwanLab服务器
EXPOSE 5173
# MySQL
EXPOSE 3306
# ClickHouse HTTP
EXPOSE 8123
# ClickHouse Native / MinIO API
EXPOSE 9000
# MinIO Console
EXPOSE 9001
# Redis
EXPOSE 6379
# Nginx
EXPOSE 80

# 数据卷
VOLUME ["/app/data", "/app/logs", "/data"]

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:5173/api/v1/cloud/health || exit 1

# 启动所有服务
CMD ["/start-services.sh"]