# SwanLab-Dashboard Docker环境配置示例
# 复制此文件为 .env 并根据需要修改配置

# ===========================================
# 基础服务端口配置
# ===========================================
DASHBOARD_PORT=5173
MYSQL_PORT=3306
REDIS_PORT=6379
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ===========================================
# MySQL数据库配置
# ===========================================
MYSQL_ROOT_PASSWORD=swanlab_root_123
MYSQL_DATABASE=swanlab_cloud
MYSQL_USER=swanlab_user
MYSQL_PASSWORD=swanlab_user_456

# ===========================================
# SwanLab-Dashboard配置
# ===========================================

# 云端同步模式选择
# - true: 启用云端同步（支持HTTP API和MySQL模式）
# - false: 仅本地模式
SWANLAB_CLOUD_SYNC=true

# API认证配置
SWANLAB_API_KEY=your_secure_api_key_here

# 工作空间配置
SWANLAB_WORKSPACE=default
SWANLAB_ALLOWED_WORKSPACES=default,demo,test,production

# 超时配置
SWANLAB_CLOUD_TIMEOUT=30

# ===========================================
# 生产环境配置（可选）
# ===========================================

# SSL证书路径（nginx使用）
# SSL_CERT_PATH=./docker/nginx/ssl/cert.pem
# SSL_KEY_PATH=./docker/nginx/ssl/key.pem

# 域名配置
# DOMAIN_NAME=your-domain.com

# ===========================================
# 开发环境配置
# ===========================================

# 开发模式（启用详细日志）
DEBUG=false

# 热重载（开发环境）
HOT_RELOAD=false